# systemd unit — IFS Internal ERP (localhost only)
# /etc/systemd/system/ifs-erp.service

[Unit]
Description=IFS Industrial ERP (Streamlit)
After=network.target

[Service]
Type=simple
User=ifs
Group=ifs
WorkingDirectory=/opt/ifs-erp
Environment=PATH=/opt/ifs-erp/venv/bin
ExecStart=/opt/ifs-erp/venv/bin/streamlit run app.py --server.port=8501 --server.address=127.0.0.1 --server.headless=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

